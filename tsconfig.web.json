{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/auto-imports.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/backend_reference/agent/shared/**/*",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/backend_reference/agent/core/**/*",
    "src/backend_reference/agent/services/**/*",
    "src/backend_reference/agent/api/**/*",
    "src/backend_reference/agent/integrations/**/*",
    "src/backend_reference/agent/utils/**/*",
    "src/backend_reference/storage/**/*",
    "src/backend_reference/index.ts",
    "src/backend_reference/plugin/**/*",
    "src/backend_reference/ssh/**/*",
    "src/backend_reference/themeManager.ts",
    "src/backend_reference/updater.ts",
    "src/backend_reference/version/**/*",
    "src/backend_reference/windowManager.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "baseUrl": ".",
    "outDir": "dist/renderer",
    "noEmit": false,
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@views/*": ["src/renderer/src/views/*"],
      "@router/*": ["src/renderer/src/router/*"],
      "@store/*": ["src/renderer/src/store/*"],
      "@utils/*": ["src/renderer/src/utils/*"],
      "@api/*": ["src/renderer/src/api/*"],
      "@config/*": ["src/renderer/src/config/*"],
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/backend_reference/agent/shared/*"],
      "@logging": ["src/renderer/src/types/logging-web-stub.d.ts"],
      "@common/*": ["src/shared/*"]
    }
  }
}
