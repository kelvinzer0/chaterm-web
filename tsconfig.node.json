{
  "include": ["electron.vite.config.*", "src/backend_reference/**/*", "src/preload/**/*", "src/shared/**/*", "package.json"],
  "exclude": ["node_modules","dist"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "outDir": "dist/main",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@services/*": ["src/backend_reference/agent/services/*"],
      "@api/*": ["src/backend_reference/agent/api/*"],
      "@integrations/*": ["src/backend_reference/agent/integrations/*"],
      "@utils/*": ["src/backend_reference/agent/utils/*"],
      "@shared/*": ["src/backend_reference/agent/shared/*"],
      "@storage/*": ["src/backend_reference/storage/*"],
      "@core/*": ["src/backend_reference/agent/core/*"],
      "@logging": ["src/backend_reference/services/logging/index.ts"],
      "@logging/*": ["src/backend_reference/services/logging/*"],
      "@perf": ["src/backend_reference/services/perf/index.ts"],
      "@perf/*": ["src/backend_reference/services/perf/*"],
      "@common/*": ["src/shared/*"]
    }
  }
}
